                "format": "uint",
                "minimum": 0,
                "type": "integer"
              },
              "base_rev": {
                "description": "The revision the planned call is based on; the commit fails with\nREVISION_CONFLICT if an entity it touches changed after it.",
                "format": "uint64",
                "minimum": 0,
                "type": "integer"
              },
              "diff": {
                "$ref": "#/$defs/BoundedDiff",
                "description": "How the font changes; empty for calls that write a file or discard\nunsaved changes."
              },
              "expires_at": {
                "description": "When the token expires (RFC 3339, UTC).",
                "type": "string"
              },
              "plan_token": {
                "description": "The single-use token to pass to `plan_commit` (or `plan_discard`)\nonce the user has confirmed the plan.",
                "type": "string"
              },
              "summary": {
                "description": "What the call does, for the user.",
                "type": "string"
              },
              "tool": {
                "description": "The tool the plan runs.",
                "type": "string"
              }
            },
            "required": [
              "plan_token",
              "expires_at",
              "tool",
              "base_rev",
              "summary",
              "affected",
              "affected_count",
              "diff"
            ],
            "type": "object"
          }
        },
        "description": "The result of a mutating tool. With `dry_run: true`, only `rev` and `plan`.",
        "oneOf": [
          {
            "required": [
              "rev",
              "touched",
              "touched_count",
              "touched_truncated"
            ]
          },
          {
            "required": [
              "rev",
              "plan"
            ]
          }
        ],
        "properties": {
          "journal_warning": {
            "description": "Present when the change applied but is not kept in the\ncrash-recovery journal: why. The change itself is fine; save the\ndocument to make it safe (after a journal failure, no change is\njournaled until the next save).",
            "type": [
              "string",
              "null"
            ]
          },
          "plan": {
            "$ref": "#/$defs/Plan",
            "description": "Only with `dry_run: true`: the plan of the call, which was not applied."
          },
          "rev": {
            "description": "The current revision after the call (unchanged when nothing changed).",
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          },
          "touched": {
            "description": "The entities the change touched, in entity order and at most 100 of\nthem (see `touched_count`): `font_info`, `vertical_metrics:<master\nid>`, `glyph_order` or `glyph:<glyph id>`.",
            "items": {
              "$ref": "#/$defs/EntityKey"
            },
            "type": "array"
          },
          "touched_count": {
            "description": "How many entities the change touched.",
            "format": "uint",
            "minimum": 0,
            "type": "integer"
          },
          "touched_truncated": {
            "description": "Whether `touched` lists only the first 100 of them.",
            "type": "boolean"
          },
          "tx": {
            "description": "The transaction id of the change, or `null` when nothing changed.",
            "format": "uint64",
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          }
        },
        "required": [
          "rev"
        ],
        "title": "MutationResult",
        "type": "object"
      },
      "annotations": {
        "title": "Delete glyphs",
        "readOnlyHint": false,
        "destructiveHint": true,
        "idempotentHint": false,
        "openWorldHint": false
      }
    },
    {
      "name": "glyph_set_outline",
      "title": "Set glyph outline",
      "description": "Replace every contour of one glyph layer of `doc` (`glyph` is a name or id; the default master when `master` is omitted) with a new outline, given either as `svg_path` (SVG path data) or as `paths` (structured contours, such as those of glyph_get), not both; `paths: []` clears the layer. `coordinate_system` works as in glyph_create. Destructive when the layer is not empty, and then may require approval depending on the server policy (APPROVAL_REQUIRED with a plan to confirm). Pass the latest `rev` you received as `base_rev`; if an entity this call touches changed after it, the call fails with REVISION_CONFLICT: re-read and retry.",
      "inputSchema": {
        "$defs": {
          "CoordinateSystem": {
            "description": "The coordinate system of an outline given as input.",
            "oneOf": [
              {
                "const": "font",
                "description": "Font coordinates: y points up, the baseline is y = 0. The default.",
                "type": "string"
              },
              {
                "const": "svg_y_down",
                "description": "SVG coordinates: y points down from the ascender of the default\nmaster (each y becomes `ascender - y`).",
                "type": "string"
              }
            ]
          },
          "GlyphId": {
            "description": "Stable identifier of a glyph. Unlike the glyph name, it never changes.",
            "format": "uuid",
            "type": "string"
          },
          "GlyphRef": {
            "anyOf": [
              {
                "$ref": "#/$defs/GlyphId",
                "description": "The stable identifier of the glyph."
              },
              {
                "description": "The name of the glyph.",
                "type": "string"
              }
            ],
            "description": "A reference to a glyph, by id or by name.\n\nSerialized as a bare string: text that parses as a UUID is an [`Id`]\n(`GlyphRef::Id`), any other text is a [`Name`] (`GlyphRef::Name`). When no\nglyph has the id, a glyph whose *name* is that same UUID text is used, so a\nglyph that happens to be named like a UUID can still be addressed.\n\n[`Id`]: GlyphRef::Id\n[`Name`]: GlyphRef::Name"
          },
          "MasterId": {
            "description": "Stable identifier of a master.",
            "format": "uuid",
            "type": "string"
          },
          "NodeInput": {
            "additionalProperties": false,
            "description": "A node of a contour given as input.",
            "properties": {
              "kind": {
                "$ref": "#/$defs/NodeKind",
                "description": "`line`, `curve` (cubic) or `qcurve` (quadratic) for an on-curve node,\nwhich names the segment arriving at it; `offcurve` for a control\npoint. A cubic segment is two `offcurve` nodes then a `curve`; a\nquadratic one is one `offcurve` then a `qcurve`."
              },
              "smooth": {
                "default": false,
                "description": "Whether the node joins its segments smoothly.",
                "type": "boolean"
              },
              "x": {
                "description": "Horizontal position.",
                "format": "double",
                "type": "number"
              },
              "y": {
                "description": "Vertical position.",
                "format": "double",
                "type": "number"
              }
            },
            "required": [
              "x",
              "y",
              "kind"
            ],
            "type": "object"
          },
          "NodeKind": {
            "description": "The role of a node within a contour.",
            "oneOf": [
              {
                "const": "line",
                "description": "An on-curve point reached by a straight segment.",
                "type": "string"
              },
              {
                "const": "curve",
                "description": "An on-curve point reached by a cubic Bezier segment.",
                "type": "string"
              },
              {
                "const": "qcurve",
                "description": "An on-curve point reached by a quadratic Bezier segment.",
                "type": "string"
              },
              {
                "const": "offcurve",
                "description": "An off-curve control point.",
                "type": "string"
              }
            ]
          },
          "PathInput": {
            "additionalProperties": false,
            "description": "A contour given as input. Contours are numbered by position; an `id` is\naccepted (so that the `paths` of glyph_get can be sent back) and ignored.",
            "properties": {
              "closed": {
                "description": "Whether the contour is closed.",
                "type": "boolean"
              },
              "id": {
                "default": null,
                "description": "Ignored: contours are numbered by their position.",
                "format": "uint32",
                "minimum": 0,
                "type": [
                  "integer",
                  "null"
                ]
              },
              "nodes": {
                "description": "The nodes, in drawing order. Outer contours run counter-clockwise,\ninner ones clockwise (y up).",
                "items": {
                  "$ref": "#/$defs/NodeInput"
                },
                "type": "array"
              }
            },
            "required": [
              "closed",
              "nodes"
            ],
            "type": "object"
          }
        },
        "additionalProperties": false,
        "description": "Arguments of `glyph_set_outline`: the document, the base revision, the glyph, the master (the default master when omitted) and the new outline, as `svg_path` or as `paths`, not both.",
        "properties": {
          "base_rev": {
            "description": "The latest `rev` you received for this document.",
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          },
          "coordinate_system": {
            "$ref": "#/$defs/CoordinateSystem",
            "default": "font",
            "description": "The coordinate system of the outline."
          },
          "doc": {
            "description": "Document handle (`doc_...`) returned by document_create or document_open.",
            "type": "string"
          },
          "dry_run": {
            "default": false,
            "description": "Only plan the call: change nothing and return `{rev, plan}`, the plan of what the call would do, with a `plan_token` that plan_commit can run once the user confirms.",
            "type": "boolean"
          },
          "glyph": {
            "$ref": "#/$defs/GlyphRef",
            "description": "The glyph, by name or id."
          },
          "master": {
            "anyOf": [
              {
                "$ref": "#/$defs/MasterId"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "The master; the default master when omitted."
          },
          "paths": {
            "default": null,
            "description": "The new outline as structured contours; `[]` clears the layer.",
            "items": {
              "$ref": "#/$defs/PathInput"
            },
            "type": [
              "array",
              "null"
            ]
          },
          "svg_path": {
            "default": null,
            "description": "The new outline as SVG path data; every subpath is a contour.",
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "doc",
          "base_rev",
          "glyph"
        ],
        "title": "GlyphSetOutlineArgs",
        "type": "object"
      },
      "outputSchema": {
        "$defs": {
          "BoundedDiff": {
            "description": "How a font changes between two states, with each list cut to its first\n100 entries; the counts are always complete.\n\nGlyphs are matched by their stable id, so a renamed glyph is modified,\nnot removed and added again.",
            "properties": {
              "added": {
                "description": "Names of the glyphs added, in glyph order (the first 100).",
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              "added_count": {
                "description": "How many glyphs were added.",
                "format": "uint",
                "minimum": 0,
                "type": "integer"
              },
              "info_changed": {
                "description": "Whether the font info or the units per em changed.",
                "type": "boolean"
              },
              "kerning_changed": {
                "description": "Whether any kerning group or kerning pair changed.",
                "type": "boolean"
              },
              "metrics_changed": {
                "description": "Whether the vertical metrics of any master changed.",
                "type": "boolean"
              },
              "modified": {
                "description": "The glyphs that changed, in glyph order (the first 100).",
                "items": {
                  "$ref": "#/$defs/GlyphDiff"
                },
                "type": "array"
              },
              "modified_count": {
                "description": "How many glyphs changed.",
                "format": "uint",
                "minimum": 0,
                "type": "integer"
              },
              "removed": {
                "description": "Names of the glyphs removed, in their former glyph order (the first\n100).",
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              "removed_count": {
                "description": "How many glyphs were removed.",
                "format": "uint",
                "minimum": 0,
                "type": "integer"
              },
              "truncated": {
                "description": "Whether any list was cut to its first 100 entries.",
                "type": "boolean"
              }
            },
            "required": [
              "added",
              "added_count",
              "removed",
              "removed_count",
              "modified",
              "modified_count",
              "info_changed",
              "metrics_changed",
              "kerning_changed",
              "truncated"
            ],
            "type": "object"
          },
          "EntityKey": {
            "description": "Identifies a revisioned part of a document: `font_info`, `vertical_metrics:<master uuid>`, `glyph_order`, `glyph:<glyph uuid>`, `kerning_group:<group uuid>` or `kerning_pair:<master uuid>:<first>:<second>`, where each side of a pair is `g.<glyph uuid>` or `k.<group uuid>`.",
            "pattern": "^(font_info|glyph_order|(vertical_metrics|glyph|kerning_group):[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}|kerning_pair:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}(:[gk]\\.[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}){2})$",
            "type": "string"
          },
          "GlyphDiff": {
            "description": "How one glyph present in both fonts differs between them.\n\nA glyph whose only change is its name or its export flag is listed with\nevery flag false.",
            "properties": {
              "advance_changed": {
                "description": "Whether the advance width changed in any master (a layer present in\nonly one of the fonts counts as a change).",
                "type": "boolean"
              },
              "components_changed": {
                "description": "Whether the components changed in any master (a layer present in only\none of the fonts counts as a change when it has components).",
                "type": "boolean"
              },
              "name": {
                "description": "The glyph name in the second font.",
                "type": "string"
              },
              "outline_changed": {
                "description": "Whether the contours changed in any master (a layer present in only\none of the fonts counts as a change).",
                "type": "boolean"
              },
              "unicodes_changed": {
                "description": "Whether the code points changed.",
                "type": "boolean"
              }
            },
            "required": [
              "name",
              "outline_changed",
              "advance_changed",
              "unicodes_changed",
              "components_changed"
            ],
            "type": "object"
          },
          "Plan": {
            "description": "A plan, as shown to the caller: in the `details` of an\n`APPROVAL_REQUIRED` error, or in the result of a call made with\n`dry_run: true`.",
            "properties": {
              "affected": {
                "description": "The names of the glyphs the call touches (at most 100).",
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              "affected_count": {
                "description": "How many glyphs, kerning pairs and kerning groups the call touches.",
                "format": "uint",
                "minimum": 0,
                "type": "integer"
              },
              "base_rev": {
                "description": "The revision the planned call is based on; the commit fails with\nREVISION_CONFLICT if an entity it touches changed after it.",
                "format": "uint64",
                "minimum": 0,
                "type": "integer"
              },
              "diff": {
                "$ref": "#/$defs/BoundedDiff",
                "description": "How the font changes; empty for calls that write a file or discard\nunsaved changes."
              },
              "expires_at": {
                "description": "When the token expires (RFC 3339, UTC).",
                "type": "string"
              },
              "plan_token": {
                "description": "The single-use token to pass to `plan_commit` (or `plan_discard`)\nonce the user has confirmed the plan.",
                "type": "string"
              },
              "summary": {
                "description": "What the call does, for the user.",
                "type": "string"
              },
              "tool": {
                "description": "The tool the plan runs.",
                "type": "string"
              }
            },
            "required": [
              "plan_token",
              "expires_at",
              "tool",
              "base_rev",
              "summary",
              "affected",
              "affected_count",
              "diff"
            ],
            "type": "object"
          }
        },
        "description": "The result of a mutating tool. With `dry_run: true`, only `rev` and `plan`.",
        "oneOf": [
          {
            "required": [
              "rev",
              "touched",
              "touched_count",
              "touched_truncated"
            ]
          },
          {
            "required": [
              "rev",
              "plan"
            ]
          }
        ],
        "properties": {
          "journal_warning": {
            "description": "Present when the change applied but is not kept in the\ncrash-recovery journal: why. The change itself is fine; save the\ndocument to make it safe (after a journal failure, no change is\njournaled until the next save).",
            "type": [
              "string",
              "null"
            ]
          },
          "plan": {
            "$ref": "#/$defs/Plan",
            "description": "Only with `dry_run: true`: the plan of the call, which was not applied."
          },
          "rev": {
            "description": "The current revision after the call (unchanged when nothing changed).",
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          },
          "touched": {
            "description": "The entities the change touched, in entity order and at most 100 of\nthem (see `touched_count`): `font_info`, `vertical_metrics:<master\nid>`, `glyph_order` or `glyph:<glyph id>`.",
            "items": {
              "$ref": "#/$defs/EntityKey"
            },
            "type": "array"
          },
          "touched_count": {
            "description": "How many entities the change touched.",
            "format": "uint",
            "minimum": 0,
            "type": "integer"
          },
          "touched_truncated": {
            "description": "Whether `touched` lists only the first 100 of them.",
            "type": "boolean"
          },
          "tx": {
            "description": "The transaction id of the change, or `null` when nothing changed.",
            "format": "uint64",
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          }
        },
        "required": [
          "rev"
        ],
        "title": "MutationResult",
        "type": "object"
      },
      "annotations": {
        "title": "Set glyph outline",
        "readOnlyHint": false,
        "destructiveHint": true,
        "idempotentHint": false,
        "openWorldHint": false
      }
    },
    {
      "name": "contour_edit",
      "title": "Edit contours",
      "description": "Add, delete, reverse or transform contours of one glyph layer of `doc` (the default master when `master` is omitted). `action` is {\"type\": \"add\", \"svg_path\" | \"path\", \"coordinate_system\"?} (an SVG path with several subpaths adds one contour each), {\"type\": \"delete\", \"path_id\"}, {\"type\": \"reverse\", \"path_id\"} or {\"type\": \"transform\", \"path_id\", \"affine\": [a, b, c, d, e, f]}, which maps (x, y) to (a*x + c*y + e, b*x + d*y + f). Contour ids come from glyph_get. Deleting the last contour of a drawn layer, or a transform that collapses the contour (a*d - b*c = 0), is destructive and may require approval depending on the server policy. Pass the latest `rev` you received as `base_rev`; if an entity this call touches changed after it, the call fails with REVISION_CONFLICT: re-read and retry.",
      "inputSchema": {
        "$defs": {
          "ContourAction": {
            "description": "An edit of the contours of a glyph layer.",
            "oneOf": [
              {
                "additionalProperties": false,
                "description": "Appends contours, given as `svg_path` (one contour per subpath) or as\none structured `path`, not both. New contours get the ids after the\nhighest existing one.",
                "properties": {
                  "coordinate_system": {
                    "$ref": "#/$defs/CoordinateSystem",
                    "default": "font",
                    "description": "The coordinate system of the new contours."
                  },
                  "path": {
                    "anyOf": [
                      {
                        "$ref": "#/$defs/PathInput"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "default": null,
                    "description": "One structured contour."
                  },
                  "svg_path": {
                    "default": null,
                    "description": "The contours as SVG path data.",
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "type": {
                    "const": "add",
                    "type": "string"
                  }
                },
                "required": [
                  "type"
                ],
                "type": "object"
              },
              {
                "additionalProperties": false,
                "description": "Removes a contour.",
                "properties": {
                  "path_id": {
                    "$ref": "#/$defs/PathId",
                    "description": "The contour to remove."
                  },
                  "type": {
                    "const": "delete",
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "path_id"
                ],
                "type": "object"
              },
              {
                "additionalProperties": false,
                "description": "Reverses the direction of a contour, keeping its shape.",
                "properties": {
                  "path_id": {
                    "$ref": "#/$defs/PathId",
                    "description": "The contour to reverse."
                  },
                  "type": {
                    "const": "reverse",
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "path_id"
                ],
                "type": "object"
              },
              {
                "additionalProperties": false,
                "description": "Applies an affine transform `[a, b, c, d, e, f]` to every node of a\ncontour: (x, y) becomes (a*x + c*y + e, b*x + d*y + f). A mirroring\ntransform also flips the direction, which is not corrected.",
                "properties": {
                  "affine": {
                    "description": "The affine coefficients `[a, b, c, d, e, f]`.",
                    "items": {
                      "format": "double",
                      "type": "number"
                    },
                    "maxItems": 6,
                    "minItems": 6,
                    "type": "array"
                  },
                  "path_id": {
                    "$ref": "#/$defs/PathId",
                    "description": "The contour to transform."
                  },
                  "type": {
                    "const": "transform",
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "path_id",
                  "affine"
                ],
                "type": "object"
              }
            ]
          },
          "CoordinateSystem": {
            "description": "The coordinate system of an outline given as input.",
            "oneOf": [
              {
                "const": "font",
                "description": "Font coordinates: y points up, the baseline is y = 0. The default.",
                "type": "string"
              },
              {
                "const": "svg_y_down",
                "description": "SVG coordinates: y points down from the ascender of the default\nmaster (each y becomes `ascender - y`).",
                "type": "string"
              }
            ]
          },
          "GlyphId": {
            "description": "Stable identifier of a glyph. Unlike the glyph name, it never changes.",
            "format": "uuid",
            "type": "string"
          },
          "GlyphRef": {
            "anyOf": [
              {
                "$ref": "#/$defs/GlyphId",
                "description": "The stable identifier of the glyph."
              },
              {
                "description": "The name of the glyph.",
                "type": "string"
              }
            ],
            "description": "A reference to a glyph, by id or by name.\n\nSerialized as a bare string: text that parses as a UUID is an [`Id`]\n(`GlyphRef::Id`), any other text is a [`Name`] (`GlyphRef::Name`). When no\nglyph has the id, a glyph whose *name* is that same UUID text is used, so a\nglyph that happens to be named like a UUID can still be addressed.\n\n[`Id`]: GlyphRef::Id\n[`Name`]: GlyphRef::Name"
          },
          "MasterId": {
            "description": "Stable identifier of a master.",
            "format": "uuid",
            "type": "string"
          },
          "NodeInput": {
            "additionalProperties": false,
            "description": "A node of a contour given as input.",
            "properties": {
              "kind": {
                "$ref": "#/$defs/NodeKind",
                "description": "`line`, `curve` (cubic) or `qcurve` (quadratic) for an on-curve node,\nwhich names the segment arriving at it; `offcurve` for a control\npoint. A cubic segment is two `offcurve` nodes then a `curve`; a\nquadratic one is one `offcurve` then a `qcurve`."
              },
              "smooth": {
                "default": false,
                "description": "Whether the node joins its segments smoothly.",
                "type": "boolean"
              },
              "x": {
                "description": "Horizontal position.",
                "format": "double",
                "type": "number"
              },
              "y": {
                "description": "Vertical position.",
                "format": "double",
                "type": "number"
              }
            },
            "required": [
              "x",
              "y",
              "kind"
            ],
            "type": "object"
          },
          "NodeKind": {
            "description": "The role of a node within a contour.",
            "oneOf": [
              {
                "const": "line",
                "description": "An on-curve point reached by a straight segment.",
                "type": "string"
              },
              {
                "const": "curve",
                "description": "An on-curve point reached by a cubic Bezier segment.",
                "type": "string"
              },
              {
                "const": "qcurve",
                "description": "An on-curve point reached by a quadratic Bezier segment.",
                "type": "string"
              },
              {
                "const": "offcurve",
                "description": "An off-curve control point.",
                "type": "string"
              }
            ]
          },
          "PathId": {
            "description": "Identifier of a contour, unique within its layer.",
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          },
          "PathInput": {
            "additionalProperties": false,
            "description": "A contour given as input. Contours are numbered by position; an `id` is\naccepted (so that the `paths` of glyph_get can be sent back) and ignored.",
            "properties": {
              "closed": {
                "description": "Whether the contour is closed.",
                "type": "boolean"
              },
              "id": {
                "default": null,
                "description": "Ignored: contours are numbered by their position.",
                "format": "uint32",
                "minimum": 0,
                "type": [
                  "integer",
                  "null"
                ]
              },
              "nodes": {
                "description": "The nodes, in drawing order. Outer contours run counter-clockwise,\ninner ones clockwise (y up).",
                "items": {
                  "$ref": "#/$defs/NodeInput"
                },
                "type": "array"
              }
            },
            "required": [
              "closed",
              "nodes"
            ],
            "type": "object"
          }
        },
        "additionalProperties": false,
        "description": "Arguments of `contour_edit`: the document, the base revision, the glyph, the master (the default master when omitted) and the action.",
        "properties": {
          "action": {
            "$ref": "#/$defs/ContourAction",
            "description": "What to do."
          },
          "base_rev": {
            "description": "The latest `rev` you received for this document.",
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          },
          "doc": {
            "description": "Document handle (`doc_...`) returned by document_create or document_open.",
            "type": "string"
          },
          "dry_run": {
            "default": false,
            "description": "Only plan the call: change nothing and return `{rev, plan}`, the plan of what the call would do, with a `plan_token` that plan_commit can run once the user confirms.",
            "type": "boolean"
          },
          "glyph": {
            "$ref": "#/$defs/GlyphRef",
            "description": "The glyph, by name or id."
          },
          "master": {
            "anyOf": [
              {
                "$ref": "#/$defs/MasterId"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "The master; the default master when omitted."
          }
        },
        "required": [
          "doc",
          "base_rev",
          "glyph",
          "action"
        ],
        "title": "ContourEditArgs",
        "type": "object"
      },
      "outputSchema": {
        "$defs": {
          "BoundedDiff": {
            "description": "How a font changes between two states, with each list cut to its first\n100 entries; the counts are always complete.\n\nGlyphs are matched by their stable id, so a renamed glyph is modified,\nnot removed and added again.",
            "properties": {
              "added": {
                "description": "Names of the glyphs added, in glyph order (the first 100).",
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              "added_count": {
                "description": "How many glyphs were added.",
                "format": "uint",
                "minimum": 0,
                "type": "integer"
              },
              "info_changed": {
                "description": "Whether the font info or the units per em changed.",
                "type": "boolean"
              },
              "kerning_changed": {
                "description": "Whether any kerning group or kerning pair changed.",
                "type": "boolean"
              },
              "metrics_changed": {
                "description": "Whether the vertical metrics of any master changed.",
                "type": "boolean"
              },
              "modified": {
                "description": "The glyphs that changed, in glyph order (the first 100).",
                "items": {
                  "$ref": "#/$defs/GlyphDiff"
                },
                "type": "array"
              },
              "modified_count": {
                "description": "How many glyphs changed.",
                "format": "uint",
                "minimum": 0,
                "type": "integer"
              },
              "removed": {
                "description": "Names of the glyphs removed, in their former glyph order (the first\n100).",
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              "removed_count": {
                "description": "How many glyphs were removed.",
                "format": "uint",
                "minimum": 0,
                "type": "integer"
              },
              "truncated": {
                "description": "Whether any list was cut to its first 100 entries.",
                "type": "boolean"
              }
            },
            "required": [
              "added",
              "added_count",
              "removed",
              "removed_count",
              "modified",
              "modified_count",
              "info_changed",
              "metrics_changed",
              "kerning_changed",
              "truncated"
            ],
            "type": "object"
          },
          "EntityKey": {
            "description": "Identifies a revisioned part of a document: `font_info`, `vertical_metrics:<master uuid>`, `glyph_order`, `glyph:<glyph uuid>`, `kerning_group:<group uuid>` or `kerning_pair:<master uuid>:<first>:<second>`, where each side of a pair is `g.<glyph uuid>` or `k.<group uuid>`.",
            "pattern": "^(font_info|glyph_order|(vertical_metrics|glyph|kerning_group):[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}|kerning_pair:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}(:[gk]\\.[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}){2})$",
            "type": "string"
          },
          "GlyphDiff": {
            "description": "How one glyph present in both fonts differs between them.\n\nA glyph whose only change is its name or its export flag is listed with\nevery flag false.",
            "properties": {
              "advance_changed": {
                "description": "Whether the advance width changed in any master (a layer present in\nonly one of the fonts counts as a change).",
                "type": "boolean"
              },
              "components_changed": {
                "description": "Whether the components changed in any master (a layer present in only\none of the fonts counts as a change when it has components).",
                "type": "boolean"
              },
              "name": {
                "description": "The glyph name in the second font.",
                "type": "string"
              },
              "outline_changed": {
                "description": "Whether the contours changed in any master (a layer present in only\none of the fonts counts as a change).",
                "type": "boolean"
              },
              "unicodes_changed": {
                "description": "Whether the code points changed.",
                "type": "boolean"
              }
            },
            "required": [
              "name",
              "outline_changed",
              "advance_changed",
              "unicodes_changed",
              "components_changed"
            ],
            "type": "object"
          },
          "Plan": {
            "description": "A plan, as shown to the caller: in the `details` of an\n`APPROVAL_REQUIRED` error, or in the result of a call made with\n`dry_run: true`.",
            "properties": {
              "affected": {
                "description": "The names of the glyphs the call touches (at most 100).",
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              "affected_count": {
                "description": "How many glyphs, kerning pairs and kerning groups the call touches.",
                "format": "uint",
                "minimum": 0,
                "type": "integer"
              },
              "base_rev": {
                "description": "The revision the planned call is based on; the commit fails with\nREVISION_CONFLICT if an entity it touches changed after it.",
                "format": "uint64",
                "minimum": 0,
                "type": "integer"
              },
              "diff": {
                "$ref": "#/$defs/BoundedDiff",
                "description": "How the font changes; empty for calls that write a file or discard\nunsaved changes."
              },
              "expires_at": {
                "description": "When the token expires (RFC 3339, UTC).",
                "type": "string"
              },
              "plan_token": {
                "description": "The single-use token to pass to `plan_commit` (or `plan_discard`)\nonce the user has confirmed the plan.",
                "type": "string"
              },
              "summary": {
                "description": "What the call does, for the user.",
                "type": "string"
              },
              "tool": {
                "description": "The tool the plan runs.",
                "type": "string"
              }
            },
            "required": [
              "plan_token",
              "expires_at",
              "tool",
              "base_rev",
              "summary",
              "affected",
              "affected_count",
              "diff"
            ],
            "type": "object"
          }
        },
        "description": "The result of a mutating tool. With `dry_run: true`, only `rev` and `plan`.",
        "oneOf": [
          {
            "required": [
              "rev",
              "touched",
              "touched_count",
              "touched_truncated"
            ]
          },
          {
            "required": [
              "rev",
              "plan"
            ]
          }
        ],
        "properties": {
          "journal_warning": {
            "description": "Present when the change applied but is not kept in the\ncrash-recovery journal: why. The change itself is fine; save the\ndocument to make it safe (after a journal failure, no change is\njournaled until the next save).",
            "type": [
              "string",
              "null"
            ]
          },
          "plan": {
            "$ref": "#/$defs/Plan",
            "description": "Only with `dry_run: true`: the plan of the call, which was not applied."
          },
          "rev": {
            "description": "The current revision after the call (unchanged when nothing changed).",
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          },
          "touched": {
            "description": "The entities the change touched, in entity order and at most 100 of\nthem (see `touched_count`): `font_info`, `vertical_metrics:<master\nid>`, `glyph_order` or `glyph:<glyph id>`.",
            "items": {
              "$ref": "#/$defs/EntityKey"
            },
            "type": "array"
          },
          "touched_count": {
            "description": "How many entities the change touched.",
            "format": "uint",
            "minimum": 0,
            "type": "integer"
          },
          "touched_truncated": {
            "description": "Whether `touched` lists only the first 100 of them.",
            "type": "boolean"
          },
          "tx": {
            "description": "The transaction id of the change, or `null` when nothing changed.",
            "format": "uint64",
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          }
        },
        "required": [
          "rev"
        ],
        "title": "MutationResult",
        "type": "object"
      },
      "annotations": {
        "title": "Edit contours",
        "readOnlyHint": false,
        "destructiveHint": true,
        "idempotentHint": false,
        "openWorldHint": false
      }
    },
    {
      "name": "nodes_edit",
      "title": "Edit nodes",
      "description": "Edit the nodes of one contour (`path_id`) of a glyph of `doc` (the default master when `master` is omitted). `action` is {\"type\": \"move\", \"indices\", \"dx\", \"dy\"} (handles do not follow: list them too), {\"type\": \"insert\", \"segment_index\", \"t\"} (split a segment, keeping the shape), {\"type\": \"delete\", \"index\"} (an on-curve node and its handles) or {\"type\": \"set_smooth\", \"index\", \"smooth\"}. Indices are positions in the contour's `nodes` from glyph_get. Pass the latest `rev` you received as `base_rev`; if an entity this call touches changed after it, the call fails with REVISION_CONFLICT: re-read and retry.",
      "inputSchema": {
        "$defs": {
          "GlyphId": {
            "description": "Stable identifier of a glyph. Unlike the glyph name, it never changes.",
            "format": "uuid",
            "type": "string"
          },
          "GlyphRef": {
            "anyOf": [
              {
                "$ref": "#/$defs/GlyphId",
                "description": "The stable identifier of the glyph."
              },
              {
                "description": "The name of the glyph.",
                "type": "string"
              }
            ],
            "description": "A reference to a glyph, by id or by name.\n\nSerialized as a bare string: text that parses as a UUID is an [`Id`]\n(`GlyphRef::Id`), any other text is a [`Name`] (`GlyphRef::Name`). When no\nglyph has the id, a glyph whose *name* is that same UUID text is used, so a\nglyph that happens to be named like a UUID can still be addressed.\n\n[`Id`]: GlyphRef::Id\n[`Name`]: GlyphRef::Name"
          },
          "MasterId": {
            "description": "Stable identifier of a master.",
            "format": "uuid",
            "type": "string"
          },
          "NodeAction": {
            "description": "An edit of the nodes of one contour. Nodes are addressed by their index\nin the contour's `nodes` (from glyph_get).",
            "oneOf": [
              {
                "additionalProperties": false,
                "description": "Moves exactly the listed nodes by `(dx, dy)`. Handles do not follow\ntheir on-curve node: list them too to move them.",
                "properties": {
                  "dx": {
                    "description": "Horizontal offset in font units.",
                    "format": "double",
                    "type": "number"
                  },
                  "dy": {
                    "description": "Vertical offset in font units.",
                    "format": "double",
                    "type": "number"
                  },
                  "indices": {
                    "description": "Indices of the nodes to move; each must exist.",
                    "items": {
                      "format": "uint",
                      "minimum": 0,
                      "type": "integer"
                    },
                    "type": "array"
                  },
                  "type": {
                    "const": "move",
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "indices",
                  "dx",
                  "dy"
                ],
                "type": "object"
              },
              {
                "additionalProperties": false,
                "description": "Splits segment `segment_index` at `t` with a new on-curve node,\nkeeping the shape. Segment `k` ends at the `k`-th on-curve node of a\nclosed contour; in an open contour it starts there.",
                "properties": {
                  "segment_index": {
                    "description": "The segment to split.",
                    "format": "uint",
                    "minimum": 0,
                    "type": "integer"
                  },
                  "t": {
                    "description": "Where to split, strictly between 0 and 1.",
                    "format": "double",
                    "type": "number"
                  },
                  "type": {
                    "const": "insert",
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "segment_index",
                  "t"
                ],
                "type": "object"
              },
              {
                "additionalProperties": false,
                "description": "Deletes an on-curve node and its handles; the segments around it\nmerge into one.",
                "properties": {
                  "index": {
                    "description": "Index of the on-curve node to delete.",
                    "format": "uint",
                    "minimum": 0,
                    "type": "integer"
                  },
                  "type": {
                    "const": "delete",
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "index"
                ],
                "type": "object"
              },
              {
                "additionalProperties": false,
                "description": "Sets whether an on-curve node is smooth; handles are not realigned.",
                "properties": {
                  "index": {
                    "description": "Index of the on-curve node.",
                    "format": "uint",
                    "minimum": 0,
                    "type": "integer"
                  },
                  "smooth": {
                    "description": "The new value of the flag.",
                    "type": "boolean"
                  },
                  "type": {
                    "const": "set_smooth",
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "index",
                  "smooth"
                ],
                "type": "object"
              }
            ]
          },
          "PathId": {
            "description": "Identifier of a contour, unique within its layer.",
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          }
        },
        "additionalProperties": false,
        "description": "Arguments of `nodes_edit`: the document, the base revision, the glyph, the master (the default master when omitted), the contour and the action.",
        "properties": {
          "action": {
            "$ref": "#/$defs/NodeAction",
            "description": "What to do."
          },
          "base_rev": {
            "description": "The latest `rev` you received for this document.",
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          },
          "doc": {
            "description": "Document handle (`doc_...`) returned by document_create or document_open.",
            "type": "string"
          },
          "dry_run": {
            "default": false,
            "description": "Only plan the call: change nothing and return `{rev, plan}`, the plan of what the call would do, with a `plan_token` that plan_commit can run once the user confirms.",
            "type": "boolean"
          },
          "glyph": {
            "$ref": "#/$defs/GlyphRef",
            "description": "The glyph, by name or id."
          },
          "master": {
            "anyOf": [
              {
                "$ref": "#/$defs/MasterId"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "The master; the default master when omitted."
          },
          "path_id": {
            "$ref": "#/$defs/PathId",
            "description": "The contour to edit (an id from glyph_get)."
          }
        },
        "required": [
          "doc",
          "base_rev",
          "glyph",
          "path_id",
          "action"
        ],
        "title": "NodesEditArgs",
        "type": "object"
      },
